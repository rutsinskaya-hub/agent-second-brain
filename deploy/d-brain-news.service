[Unit]
Description=d-brain News Digest

[Service]
Type=oneshot
User=myuser
WorkingDirectory=/home/myuser/projects/agent-second-brain
EnvironmentFile=/home/myuser/projects/agent-second-brain/.env
ExecStart=/home/myuser/.local/bin/uv run python3 /home/myuser/projects/agent-second-brain/scripts/news_digest.py --topic all --hours 12
Environment=PYTHONUNBUFFERED=1
